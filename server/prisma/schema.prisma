// Bellwether — Prisma schema
// Core tables: Account, Post, IngestionRun
// Design principle: real and seeded data share ONE schema so the rest of the
// system (analytics, AI layer, dashboard) never needs to know where a row came from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Platform {
  INSTAGRAM
  FACEBOOK
  X
  YOUTUBE
}

enum AccountRole {
  PRINCIPAL
  COMPETITOR
}

enum MediaType {
  REEL_SHORT_VIDEO
  LONG_FORM_VIDEO
  CAROUSEL
  SINGLE_IMAGE
  TEXT_ONLY
  LINK
  LIVE
}

enum ContentPillar {
  POLICY_ANNOUNCEMENT
  CONSTITUENCY_VISIT
  PERSONAL_FAMILY
  ATTACK_REBUTTAL
  FESTIVAL_GREETING
  ACHIEVEMENT_CLAIM
  MEDIA_APPEARANCE
  OTHER
}

// ── Core tables ──────────────────────────────────────────────────────────

// One row per tracked social account (e.g. "Shashi Tharoor on X").
// Note: the same PERSON has multiple Account rows, one per platform —
// this is what lets an account be real on YouTube and seeded on Instagram.
model Account {
  id            String      @id @default(cuid())
  personName    String      // e.g. "Shashi Tharoor" — links accounts across platforms
  role          AccountRole // PRINCIPAL or COMPETITOR
  platform      Platform
  handle        String      // platform-specific username/channel id
  displayName   String
  followerCount Int?        // nullable — not always available, never used to "rank"
  isSynthetic   Boolean     @default(false) // true = this account's data is seeded, not live

  posts          Post[]
  ingestionRuns  IngestionRun[]
  createdAt      DateTime       @default(now())

  @@unique([platform, handle])
  @@index([personName])
}

// One row per post, normalised across all platforms.
model Post {
  id          String     @id @default(cuid())
  account     Account    @relation(fields: [accountId], references: [id])
  accountId   String

  platform    Platform   // denormalised for fast filtering/queries
  postId      String     // platform's native post/video id
  postedAt    DateTime   // stored in UTC; converted to account-local tz at query time
  mediaType   MediaType
  caption     String?
  permalink   String?    // null for fully synthetic posts (nothing real to link to)

  // Metrics — nullable individually since platforms disagree on what they expose
  likes       Int?
  comments    Int?
  shares      Int?
  views       Int?
  saves       Int?

  theme       ContentPillar?  // set by the AI classification step (Module D)
  themeConfidence Float?

  isSynthetic Boolean    @default(false) // true = generated by the seed script, not fetched live

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([platform, postId]) // prevents duplicate rows on repeated ingestion (FR15)
  @@index([accountId, postedAt])
  @@index([platform, mediaType])
}

// One row per ingestion attempt — this is your audit trail (Module A, SHOULD).
// When numbers on the dashboard look wrong, this table is the first place to check.
model IngestionRun {
  id          String   @id @default(cuid())
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String

  source      String   // e.g. "youtube_api", "seed_csv"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  rowsFetched Int      @default(0)
  rowsFailed  Int      @default(0)
  status      String   @default("running") // "running" | "success" | "failed"
  errorNote   String?

  @@index([accountId, startedAt])
}
