# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres connection string (Supabase, or any Postgres instance).
#
# IMPORTANT if you are using Supabase: use the CONNECTION POOLER URL, not the
# direct one. Supabase serves direct connections (db.<ref>.supabase.co) over IPv6
# ONLY, so on an IPv4-only network — which most home and office connections still
# are — Prisma fails with "P1001: Can't reach database server" and no hint as to why.
#
# The pooler is dual-stack and works everywhere. Note the username differs: it is
# postgres.<project-ref>, not plain postgres.
#
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#                      -> Session pooler   (port 5432, supports migrations)
#
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# The aws-<n> prefix is per-project and not guessable — copy it from the dashboard.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Google Gemini API key — used by the classification and recommendation calls (Module D).
# Get one at https://aistudio.google.com/apikey
#
# Optional: every analytics route works without it. Only theme classification and
# the recommendation layer need a key, and both fail with a 503 that says so
# rather than a stack trace.
#
# IF YOU HIT A QUOTA 429, READ THIS BEFORE MINTING A NEW KEY. The free tier meters
# requests per DAY, per PROJECT, per MODEL. The middle term is the trap: a second
# API key created inside the SAME Google project draws on the same spent bucket and
# fails identically, which looks exactly like the new key not being picked up. A
# fresh allowance means a key from a NEW project, or a different Google account.
GEMINI_API_KEY=""

# Optional. Comma-separated model chains, primary first. A model whose DAILY quota
# is spent is skipped for the next one mid-run — and since the quota is metered per
# model, a spent gemini-3.6-flash says nothing about gemini-3.5-flash on the SAME
# key. That makes switching models the fastest way out of a quota wall, which is why
# it is configurable here rather than only in code.
#
# Leave empty for the defaults in server/src/ai/gemini.ts.
GEMINI_CLASSIFY_MODEL=""
GEMINI_RECOMMEND_MODEL=""

# YouTube Data API v3 key. Required — YouTube accounts are ingested live, and
# without a key their runs fail rather than falling back to generated data.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Apify API token — serves the Instagram accounts (apify/instagram-post-scraper
# for posts, apify/instagram-profile-scraper for follower counts).
# Apify Console -> Settings -> API & Integrations.
#
# Required for Instagram ingestion. Apify bills per scraped result, so a full
# 90-day refresh of four accounts is the main cost in this project.
APIFY_API_TOKEN=""

# Optional. Posts fetched per Instagram account per run (default 200). The actor
# returns newest first, so lowering this drops the OLDEST posts in the window.
# Raise it for an account that posts more than ~200 times in 90 days.
APIFY_RESULTS_LIMIT=""

PORT=4000
