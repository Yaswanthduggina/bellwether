# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres connection string (Supabase, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Anthropic API key — used by the classification and recommendation calls (Module D)
ANTHROPIC_API_KEY=""

# YouTube Data API v3 key. Optional: leave blank to run entirely on seeded data.
YOUTUBE_API_KEY=""

PORT=4000
